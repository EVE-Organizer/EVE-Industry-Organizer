# EVE SSO (optional). Create an app at https://developers.eveonline.com
# Register the callback URL shown in Settings when SSO is not configured.
# Under Permissions, enable "Read character blueprints" (esi-characters.read_blueprints.v1)
# so Jobs can show ME/TE research progress (e.g. TE 0% → 2%).

# Local dev example:
# VITE_EVE_CLIENT_ID=your-client-id
# VITE_EVE_CALLBACK_URL=http://localhost:5173/auth/callback

# GitHub Pages example:
# VITE_EVE_CALLBACK_URL=https://eve-organizer.github.io/EVE-Industry-Organizer/auth/callback

VITE_EVE_CLIENT_ID=
